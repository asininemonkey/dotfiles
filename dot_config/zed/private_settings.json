{
  "agent": {
    "default_model": {
      "enable_thinking": true,
      "model": "digitsflow/bonsai-8b",
      "provider": "ollama"
    }
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "editorconfig": true,
    "env": true,
    "git-firefly": true,
    "helm": true,
    "ini": true,
    "kdl": true,
    "make": true,
    "nix": true,
    "scss": true,
    "sql": true,
    "terraform": true,
    "toml": true
  },
  "colorize_brackets": true,
  "git_panel": {
    "dock": "right"
  },
  "language_models": {
    "ollama": {
      "api_url": "http://127.0.0.1:11434"
    }
  },
  "minimap": {
    "show": "always"
  },
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "line_height": "standard"
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "dark"
  }
}
