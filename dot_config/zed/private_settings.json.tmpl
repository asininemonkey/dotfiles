{
  // https://github.com/zed-industries/zed/blob/main/docs/src/reference/all-settings.md
  "agent": {
    "default_model": {
      "enable_thinking": true,
      "provider": "{{ .llm.provider.name }}",
      "model": "{{ .llm.provider.model }}"
    }
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "editorconfig": true,
    "env": true,
    "git-firefly": true,
    "helm": true,
    "ini": true,
    "kdl": true,
    "make": true,
    "nix": true,
    "scss": true,
    "sql": true,
    "terraform": true,
    "toml": true
  },
  "buffer_font_size": 16,
  "colorize_brackets": true,
  "context_servers": {
    "terraform-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": "Zed (Default)",
  "language_models": {
    "{{ .llm.provider.name }}": {
      "api_url": "http://{{ .llm.server.hostname }}:{{ .llm.server.port }}"
    }
  },
  "minimap": {
    "show": "always"
  },
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "line_height": "standard"
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "dark"
  },
  "ui_font_size": 16
}
