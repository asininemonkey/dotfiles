{
  // https://github.com/zed-industries/zed/blob/main/docs/src/reference/all-settings.md
  "agent": {
    "default_model": {
      "enable_thinking": true,
      "provider": "llama.cpp",
      "model": "prism-ml/Bonsai-27B-gguf:Q1_0"
    }
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "editorconfig": true,
    "env": true,
    "git-firefly": true,
    "helm": true,
    "ini": true,
    "kdl": true,
    "make": true,
    "nix": true,
    "scss": true,
    "sql": true,
    "terraform": true,
    "toml": true
  },
  "buffer_font_size": 16,
  "colorize_brackets": true,
  "context_servers": {
    "terraform-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": "Zed (Default)",
  "language_models": {
    "llama.cpp": {
      "api_url": "{{ if contains "WSL2" .chezmoi.kernel.osrelease -}}http://jose-desktop-windows:9931{{- else -}}http://127.0.0.1:9931{{- end }}"
    }
  },
  "minimap": {
    "show": "always"
  },
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "line_height": "standard"
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "dark"
  },
  "ui_font_size": 16
}
