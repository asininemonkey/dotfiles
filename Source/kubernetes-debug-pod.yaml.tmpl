# kubectl exec --namespace {{ .user.name.short }} --stdin --tty alpine -- /bin/sh
---
apiVersion: v1
kind: Namespace
metadata:
  labels:
    app.kubernetes.io/name: {{ .user.name.short }}
    pod-security.kubernetes.io/audit: privileged
    pod-security.kubernetes.io/enforce-version: latest
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/warn: privileged
  name: {{ .user.name.short }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    app.kubernetes.io/name: {{ .user.name.short }}
  name: {{ .user.name.short }}
  namespace: {{ .user.name.short }}
data:
  bootstrap.bash: |
    #!/usr/bin/env sh
    set -ex
    apk add --force-refresh --no-cache stress-ng tini
    # tini -s -- stress-ng --cpu 0
    # tini -s -- stress-ng --vm 1 --vm-bytes 128M --vm-keep
    tini -s -- sleep infinity
