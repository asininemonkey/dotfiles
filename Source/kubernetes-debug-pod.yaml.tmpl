---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/name: {{ .user.name.short }}
  name: {{ .user.name.short }}
  namespace: {{ .user.name.short }}
spec:
  replicas: 1
  revisionHistoryLimit: 10
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .user.name.short }}
  strategy:
    rollingUpdate:
      maxSurge: 25%
      maxUnavailable: 1
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ .user.name.short }}
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - podAffinityTerm:
                labelSelector:
                  matchExpressions:
                    - key: app.kubernetes.io/name
                      operator: In
                      values:
                        - {{ .user.name.short }}
                topologyKey: kubernetes.io/hostname
              weight: 100
      containers:
        - command:
            - /bootstrap.bash
          image: alpine
          imagePullPolicy: Always
          name: alpine
          resources:
            limits:
              cpu: 1000m
              memory: 256M
            requests:
              cpu: 500m
              memory: 128M
          securityContext:
            capabilities:
              add:
                - NET_ADMIN
          volumeMounts:
            - mountPath: /bootstrap.bash
              name: {{ .user.name.short }}
              subPath: bootstrap.bash
            # - mountPath: /mnt/{{ .user.name.short }}
            #   name: {{ .user.name.short }}
      volumes:
        - configMap:
            defaultMode: 0555
            name: {{ .user.name.short }}
          name: {{ .user.name.short }}
        # - persistentVolumeClaim:
        #     claimName: {{ .user.name.short }}
        #   name: {{ .user.name.short }}
