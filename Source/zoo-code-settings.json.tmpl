{
    "globalSettings": {
        "allowedCommands": [
            "git diff",
            "git log",
            "git show"
        ],
        "deniedCommands": [],
        "destructiveCommandGuardEnabled": true,
        "lastSettingsExportPath": "/home/{{ .user.name.short }}/Source/zoo-code-settings.json",
        "telemetrySetting": "disabled"
    },
    "providerProfiles": {
        "apiConfigs": {
            "llama.cpp": {
                "apiProvider": "openai",
