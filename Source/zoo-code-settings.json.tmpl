        "currentApiConfigName": "llama.cpp",
        "modeApiConfigs": {
            "architect": "llama-cpp",
            "ask": "llama-cpp",
            "code": "llama-cpp",
            "debug": "llama-cpp",
            "orchestrator": "llama-cpp"
        }
    }
