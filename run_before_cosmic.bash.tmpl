{{ if and (eq .chezmoi.osRelease.id "arch") (not (contains "WSL2" .chezmoi.kernel.osrelease)) -}}
#!/usr/bin/env bash

set -eu

if [ -f /home/{{ .user.name.short }}/.local/state/cosmic-comp/outputs.ron ]
then
  cat /home/{{ .user.name.short }}/.local/state/cosmic-comp/outputs.ron | sudo tee /var/lib/cosmic-greeter/.local/state/cosmic-comp/outputs.ron > /dev/null
fi
{{ end }}
