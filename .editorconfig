# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{bash,py,sh,zsh}]
indent_size = 4

[*.{hcl,json,md,nix,tf,yaml,yml}]
indent_size = 2

[*.lock]
indent_size = unset
indent_style = unset

[{M,m}akefile]
indent_style = tab
