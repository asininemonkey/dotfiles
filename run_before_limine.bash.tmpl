{{ if and (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.hostname "asrock-x570-linux") -}}
#!/usr/bin/env bash

set -eu

if ! grep remember_last_entry /boot/EFI/arch-limine/limine.conf &> /dev/null
then
    sudo cp /boot/EFI/arch-limine/limine.conf /boot/EFI/arch-limine/limine.conf.$(date +%Y%m%d_%H%M%S)

cat << EOF | sudo tee /boot/EFI/arch-limine/limine.conf > /dev/null
# https://github.com/limine-bootloader/limine/blob/v12.x/CONFIG.md
remember_last_entry: yes
timeout: 5

/Arch Linux
    protocol: efi
    path: boot():/EFI/Linux/arch-linux.efi
    cmdline: root=PARTUUID=$(blkid --match-tag PARTUUID --match-token TYPE=btrfs --output value) zswap.enabled=0 rw rootfstype=btrfs

/Windows
    protocol: efi
    path: uuid($(blkid --match-tag PARTUUID --match-token LABEL_FATBOOT=BOOT --output value)):/EFI/Microsoft/Boot/bootmgfw.efi
EOF
fi
{{ end }}
