alias tsmgb='sudo tailscale up --accept-routes --exit-node gb-glw-wg-001.mullvad.ts.net --operator {{ .user.name.short }} --reset --ssh'
alias tsmie='sudo tailscale up --accept-routes --exit-node ie-dub-wg-101.mullvad.ts.net --operator {{ .user.name.short }} --reset --ssh'
alias tsmus='sudo tailscale up --accept-routes --exit-node us-chi-wg-301.mullvad.ts.net --operator {{ .user.name.short }} --reset --ssh'
